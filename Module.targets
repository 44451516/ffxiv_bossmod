<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="Common.targets" />

  <PropertyGroup>
    <Use_DalamudPackager>false</Use_DalamudPackager>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)\BossMod\BossMod.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>

    <ProjectReference Include="$(MSBuildThisFileDirectory)\CodeAnalysis\CodeAnalysis.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyDll" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Copy
      SourceFiles="$(OutDir)\$(AssemblyName).dll"
      DestinationFolder="$(AppData)\vbm\modules-dev" />
  </Target>

  <!-- ModulePackService installs modules from the directory containing BossMod.dll, which is release\ for Release builds -->
  <Target Name="CopyReleaseDll" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy
      SourceFiles="$(OutDir)\$(AssemblyName).dll"
      DestinationFolder="$(MSBuildThisFileDirectory)release" />
  </Target>
</Project>
